# =============================================================================
#  CMP Voice Agent — шаблон окружения
#  Скопируйте в .env рядом с этим файлом (или в /etc/cmp-voice.env для systemd)
#  и заполните токен. Файл .env в git не попадает.
#
#  Токен MCP: положите его ОДНОЙ строкой в файл ~/.wormsoft-token
#  (права 600) либо задайте переменной WORM_TOKEN ниже.
#  Рекомендуемый путь:  /home/<user>/.wormsoft-token
# =============================================================================

# ------------------------------- LLM-демон -----------------------------------
BONSAI_MODEL=/home/ubuntu/models/bonsai9/PQ2_0.gguf
BONSAI_CTX=32768
BONSAI_BATCH=256
BONSAI_THREADS=4
BONSAI_GPU_LAYERS=99
BONSAI_PORT=18521
BONSAI_HOST=127.0.0.1
# KV q8_0 + flash-attention. Если на sm_75 q8-KV не поднимется — поставьте 0
# (f16-KV) и уменьшите контекст вдвое.
BONSAI_KV_Q8=1
BONSAI_WARMUP=1
# Карта одна на все процессы
CUDA_VISIBLE_DEVICES=0
# Сэмплирование (значения с карточки модели, thinking off)
BONSAI_TEMP=0.7
BONSAI_TOP_P=0.8
BONSAI_TOP_K=20
BONSAI_MIN_P=0
BONSAI_PRESENCE_PENALTY=1.5
BONSAI_REPEAT_PENALTY=1.0
BONSAI_PENALTY_LAST_N=64
BONSAI_MAX_GEN_TOKENS=256

# ------------------------------- Voice-сервис --------------------------------
LLM_HOST=127.0.0.1
LLM_PORT=18521
LLM_TIMEOUT_READ=120
VOICE_HOST=127.0.0.1
VOICE_PORT=8110
VOICE_MAX_GEN_TOKENS=200
VOICE_MAX_TOOL_ROUNDS=3
VOICE_TOOLS_ENABLED=1

# ------------------------------- TTS -----------------------------------------
# Активный движок по умолчанию: qwen | kokoro | none
TTS_BACKEND=silero
TTS_TIMEOUT=60
TTS_KOKORO_DIR=/home/ubuntu/cmp-voice/models/kokoro-ru-fp32
TTS_KOKORO_VOICE=sveta
TTS_KOKORO_PROVIDER=cuda
TTS_KOKORO_SPEED=1.0
# Silero v5_6 ru — отдельный процесс (torch CPU-only), диктор xenia
TTS_SILERO_URL=http://127.0.0.1:8023
TTS_SILERO_VOICE=xenia
SILERO_MODEL=/home/ubuntu/cmp-voice/models/silero/v5_6_ru.pt
SILERO_PORT=8023
SILERO_THREADS=3
SILERO_LANG=ru
# Нормализация текста для Silero: в токенсете нет цифр и латиницы.
# SILERO_NORMALIZE=1 — числа прописью, даты, деньги, сокращения, транслит.
# SILERO_NORMALIZE_LATIN=1 — отдельно управляет только транслитом латиницы.
SILERO_NORMALIZE=1
SILERO_NORMALIZE_LATIN=1
TTS_MIN_CLAUSE_CHARS=12
TTS_SOFT_BREAK_CHARS=60
TTS_MAX_CLAUSE_CHARS=210

# ------------------------------- ASR -----------------------------------------
ASR_MODEL_DIR=/home/ubuntu/tone_asr/sherpa-onnx-streaming-t-one-russian-2025-09-08
ASR_MODE=server
ASR_NUM_THREADS=2
ASR_SILENCE_FINAL=2.4
ASR_SILENCE_AFTER_TEXT=1.2
ASR_MAX_UTTERANCE=20.0
ASR_LEAD_SILENCE=0.75
ASR_TAIL_SILENCE=1.0

# ------------------------------- Инструменты / MCP ---------------------------
# Адрес MCP-сервера (при смене эндпоинта пересобирать код не нужно)
WORM_MCP_URL=https://ai.wormsoft.ru/api/mcp
WORM_MCP_TIMEOUT=45
# Токен: ЛИБО значением здесь, ЛИБО файлом (приоритет у переменной).
# WORM_TOKEN=
WORM_TOKEN_FILE=/home/ubuntu/.wormsoft-token
# Явный путь к env-файлу (если нужен нестандартный)
# VOICE_ENV_FILE=/etc/cmp-voice.env

# ------------------------------- Dev-сервис qwen08 ---------------------------
QWEN08_MODEL=/home/ubuntu/models/Qwen3.5-0.8B-Q4_K_M.gguf
QWEN08_CTX=32768
QWEN08_PORT=8081
QWEN08_API_KEY_FILE=/home/ubuntu/cmp-voice/run/qwen08-apikey

# ------------------------------- Qwen3-TTS сервер ----------------------------
QWEN_TTS_PORT=8022
QWEN_TTS_DEVICE=cuda:0
QWEN_TTS_MODEL_DIR=/home/ubuntu/tts/models/gguf

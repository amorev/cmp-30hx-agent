[Unit]
Description=CMP Voice — ASGI voice service (streaming ASR + incremental prefill + TTS)
Documentation=file:///home/ubuntu/cmp-voice/README.md
After=network.target cmp-llm.service
# Демон может перезапускаться независимо: сервис переподключается сам.
Wants=cmp-llm.service
Wants=cmp-silero-tts.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/cmp-voice
EnvironmentFile=-/etc/cmp-voice.env
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PATH=/home/ubuntu/cmp-voice/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ubuntu/cmp-voice
ExecStart=/home/ubuntu/cmp-voice/.venv/bin/python -m voice.app
Restart=always
RestartSec=5
TimeoutStopSec=15
MemoryHigh=6G
MemoryMax=8G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
